{
  "manifest_version": 3,
  "name": "Prazos CPC e Feriados Municipais — TJCE Cariri",
  "version": "2.17.1",
  "description": "Calculadora de prazos do CPC/2015 com feriados municipais das comarcas do Cariri lidos das portarias do DJEA do TJCE.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "https://djea-con.tjce.jus.br/*",
    "https://www.tjce.jus.br/*",
    "https://*.tjce.jus.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir calculadora de prazos (TJCE)",
    "default_icon": {
      "16": "icone16.png",
      "48": "icone48.png"
    }
  },
  "icons": {
    "16": "icone16.png",
    "48": "icone48.png",
    "128": "icone128.png"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://www.tjce.jus.br/*",
        "https://*.tjce.jus.br/*"
      ],
      "js": [
        "cal-gancho.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.tjce.jus.br/*",
        "https://*.tjce.jus.br/*"
      ],
      "js": [
        "cal-ponte.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}